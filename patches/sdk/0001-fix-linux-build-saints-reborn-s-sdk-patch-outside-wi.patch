     }
     if (id.size() < 16) {
       uint8_t rnd[16] = {};
+#ifdef _WIN32
       if (BCryptGenRandom(nullptr, rnd, sizeof(rnd), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0) {
         const uint64_t t = GetTickCount64() ^ (uint64_t(GetCurrentProcessId()) << 32);
         std::memcpy(rnd, &t, 8);
       }
+#else
+      std::random_device rd;
+      for (auto& b : rnd) b = uint8_t(rd());
+#endif
       id = Hex(rnd, sizeof(rnd));
       if (FILE* f = std::fopen(path.c_str(), "wb")) {
         std::fwrite(id.data(), 1, id.size(), f);
         std::fclose(f);
       }
     }
+#ifdef _WIN32
     char pc[MAX_COMPUTERNAME_LENGTH + 1] = {};
     DWORD pc_n = sizeof(pc);
     GetComputerNameA(pc, &pc_n);
     char user[256] = {};
     DWORD user_n = 0;
     if (const DWORD got = GetEnvironmentVariableA("USERNAME", user, sizeof(user)); got && got < sizeof(user)) user_n = got;
+#else
+    char pc[256] = {};
+    gethostname(pc, sizeof(pc) - 1);
+    const size_t pc_n = std::strlen(pc);
+    const char* user_env = std::getenv("USER");
+    const char* user = user_env ? user_env : "";
+    const size_t user_n = std::strlen(user);
+#endif
     const std::string key = "saintsreborn-xuid|" + id + "|" + std::string(pc, pc_n) + "|" + std::string(user, user_n);
     uint64_t h = 1469598103934665603ull;
     for (char c : key) { h ^= uint8_t(c); h *= 1099511628211ull; }
