 src/graphics/shared_memory.cpp        |  1 +
 src/kernel/xam/apps/xgi_app.cpp       |  1 +
 src/kernel/xam/apps/xgi_live.inc      |  8 +++---
 src/kernel/xam/apps/xlivebase_app.cpp |  7 +++---
 src/kernel/xam/xam_net.cpp            | 25 ++++++++++++++++---
 src/system/eos_lan_off.cpp            |  4 ++-
 src/system/online_identity.cpp        | 35 +++++++++++++++++++++++++++
 src/system/xsocket.cpp                |  1 +
 9 files changed, 104 insertions(+), 12 deletions(-)
 create mode 100644 include/rex/win32_shims.h

diff --git a/include/rex/win32_shims.h b/include/rex/win32_shims.h
new file mode 100644
index 0000000..1be04a2
--- /dev/null
+++ b/include/rex/win32_shims.h
@@ -0,0 +1,34 @@
+/**
+ * Saints Reborn ARM64: the few Win32 calls the Saints Reborn SDK patch makes
+ * outside its _WIN32 blocks, for Linux and macOS builds.
+ */
+#pragma once
+
+// Functions the game executable looks up in the runtime by name.
+#if defined(_WIN32)
+#define REX_SR_EXPORT __declspec(dllexport)
+#else
+#define REX_SR_EXPORT __attribute__((visibility("default")))
+#endif
+
+#if !defined(_WIN32)
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+#include <unistd.h>
+
+inline uint64_t GetTickCount64() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+inline void Sleep(uint32_t milliseconds) {
+  std::this_thread::sleep_for(std::chrono::milliseconds(milliseconds));
+}
+
+inline uint32_t GetCurrentProcessId() { return uint32_t(getpid()); }
+
+using SOCKET = int;
+#endif
