@@ -1270,15 +1277,25 @@ i32 NetDll_select_entry(i32 caller, i32 nfds, ppc_ptr_t<x_fd_set> readfds,
     while (true) {
       fd_set r = native_readfds;
       bool companion = false;
+      // Windows ignores select's first argument; POSIX needs the highest
+      // descriptor + 1.
+      int max_fd = -1;
+      for (uint32_t i = 0; i < host_readfds.count; ++i)
+        max_fd = std::max(max_fd, int(host_readfds.sockets[i]->native_handle()));
       for (uint64_t h : BoundDatagramSockets()) {
+#if REX_PLATFORM_WIN32
         if (r.fd_count >= FD_SETSIZE) break;
+#else
+        if (h >= FD_SETSIZE) continue;
+#endif
         if (!FD_ISSET(SOCKET(h), &r)) {
           FD_SET(SOCKET(h), &r);
           companion = true;
+          max_fd = std::max(max_fd, int(h));
         }
       }
       timeval slice{0, 250000};
-      ret = select(0, &r, nullptr, nullptr, &slice);
+      ret = select(max_fd + 1, &r, nullptr, nullptr, &slice);
       if (ret < 0) break;
       if (ret == 0) {
         GatesTimer();
@@ -1444,7 +1461,7 @@ u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_
   auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
   if (!socket || !name) { XThread::SetLastError(0x2736); return -1; }
   sockaddr_in a{};
-  int len = sizeof(a);
+  host_socklen_t len = sizeof(a);
   if (getsockname(socket->native_handle(), (sockaddr*)&a, &len) != 0) return -1;
   name->sin_family = 2;
   name->sin_port = ntohs(a.sin_port);
@@ -1457,8 +1474,8 @@ u32 NetDll_getsockopt_entry(u32 caller, u32 socket_handle, u32 level, u32 optnam
                             mapped_void optval_ptr, mapped_u32 optlen_ptr) {
   auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
   if (!socket) { XThread::SetLastError(0x2736); return -1; }
-  int len = optlen_ptr ? int(*optlen_ptr) : 0;
-  std::vector<char> tmp(size_t(std::max(len, 4)), 0);
+  host_socklen_t len = optlen_ptr ? host_socklen_t(*optlen_ptr) : 0;
+  std::vector<char> tmp(size_t(std::max<int>(int(len), 4)), 0);
   if (getsockopt(socket->native_handle(), level, optname, tmp.data(), &len) != 0) {
