From e8adc3562eba53fadda903db0ad71bb62b22e3ea Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Sat, 17 Oct 2026 16:05:04 +0000
Subject: [PATCH] fix(vulkan): keep swapchain images uncompressed for the
 compositor

Turnip compresses BGRA8 swapchain images with UBWC and gamescope
composites them with block garbage, so MangoHud, the Steam overlay and
the quick access menu flicker and pixelate over time. Listing the
R/B-swapped format as a view format puts the image in another UBWC
class, so only the swapchain stays uncompressed while the game's render
targets keep compression. On by default on Linux
(vulkan_swapchain_uncompressed).
---
 include/rex/ui/vulkan/device.h     |  1 +
 src/ui/vulkan/vulkan_device.cpp    |  2 ++
 src/ui/vulkan/vulkan_presenter.cpp | 49 ++++++++++++++++++++++++++++++
 3 files changed, 52 insertions(+)

diff --git a/include/rex/ui/vulkan/device.h b/include/rex/ui/vulkan/device.h
index 258a2cd..0ee8620 100644
--- a/include/rex/ui/vulkan/device.h
+++ b/include/rex/ui/vulkan/device.h
@@ -190,6 +190,7 @@ class VulkanDevice {
     // Has optional features not implied by this being true.
     bool ext_1_1_KHR_sampler_ycbcr_conversion = false;  // #157
     bool ext_1_1_KHR_bind_memory2 = false;              // #158
+    bool ext_KHR_swapchain_mutable_format = false;      // #201
     bool ext_1_2_KHR_spirv_1_4 = false;                 // #237
     bool ext_EXT_memory_budget = false;                 // #238
     // Has optional features not implied by this being true.
diff --git a/src/ui/vulkan/vulkan_device.cpp b/src/ui/vulkan/vulkan_device.cpp
index b8a9508..d23d62c 100644
--- a/src/ui/vulkan/vulkan_device.cpp
+++ b/src/ui/vulkan/vulkan_device.cpp
@@ -201,6 +201,8 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
   if (with_swapchain) {
     // #2.
     XE_UI_VULKAN_STRUCT_EXTENSION(KHR_swapchain)
+    // #201.
+    XE_UI_VULKAN_STRUCT_EXTENSION(KHR_swapchain_mutable_format)
   }
 
   bool ext_1_2_KHR_sampler_mirror_clamp_to_edge = false;
diff --git a/src/ui/vulkan/vulkan_presenter.cpp b/src/ui/vulkan/vulkan_presenter.cpp
index 6ad2a77..af93577 100644
--- a/src/ui/vulkan/vulkan_presenter.cpp
+++ b/src/ui/vulkan/vulkan_presenter.cpp
@@ -58,6 +58,16 @@ REXCVAR_DEFINE_BOOL(vulkan_allow_present_mode_mailbox, true, "UI/Vulkan",
 REXCVAR_DEFINE_BOOL(vulkan_allow_present_mode_fifo_relaxed, true, "UI/Vulkan",
                     "Allow FIFO relaxed present mode");
 
+#if REX_PLATFORM_LINUX
+#define REX_VULKAN_SWAPCHAIN_UNCOMPRESSED_DEFAULT true
+#else
+#define REX_VULKAN_SWAPCHAIN_UNCOMPRESSED_DEFAULT false
+#endif
+REXCVAR_DEFINE_BOOL(vulkan_swapchain_uncompressed, REX_VULKAN_SWAPCHAIN_UNCOMPRESSED_DEFAULT,
+                    "UI/Vulkan",
+                    "Keep swapchain images out of framebuffer compression so a compositor "
+                    "such as gamescope samples them correctly");
+
 namespace rex {
 namespace ui {
 namespace vulkan {
@@ -1403,6 +1413,45 @@ VkSwapchainKHR VulkanPresenter::PaintContext::CreateSwapchainForVulkanSurface(
   }
   swapchain_create_info.clipped = VK_TRUE;
   swapchain_create_info.oldSwapchain = old_swapchain;
+  // Freedreno/Turnip compresses (UBWC) BGRA8 swapchain images, and gamescope
+  // composites such images with block garbage over time (the overlays and the
+  // quick access menu flicker and pixelate). Allowing a view with R and B
+  // swapped puts the image in a different UBWC class, so the driver keeps it
+  // uncompressed, while the game's own render targets stay compressed.
+  VkFormat swapchain_view_formats[2];
+  VkImageFormatListCreateInfo swapchain_format_list;
+  if (REXCVAR_GET(vulkan_swapchain_uncompressed) &&
+      vulkan_device->extensions().ext_KHR_swapchain_mutable_format &&
+      vulkan_device->extensions().ext_1_2_KHR_image_format_list) {
+    VkFormat swapped_format = VK_FORMAT_UNDEFINED;
+    switch (swapchain_create_info.imageFormat) {
+      case VK_FORMAT_B8G8R8A8_UNORM:
+        swapped_format = VK_FORMAT_R8G8B8A8_UNORM;
+        break;
+      case VK_FORMAT_R8G8B8A8_UNORM:
+        swapped_format = VK_FORMAT_B8G8R8A8_UNORM;
+        break;
+      case VK_FORMAT_B8G8R8A8_SRGB:
+        swapped_format = VK_FORMAT_R8G8B8A8_SRGB;
+        break;
+      case VK_FORMAT_R8G8B8A8_SRGB:
+        swapped_format = VK_FORMAT_B8G8R8A8_SRGB;
+        break;
+      default:
+        break;
+    }
+    if (swapped_format != VK_FORMAT_UNDEFINED) {
+      swapchain_view_formats[0] = swapchain_create_info.imageFormat;
+      swapchain_view_formats[1] = swapped_format;
+      swapchain_format_list.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO;
+      swapchain_format_list.pNext = nullptr;
+      swapchain_format_list.viewFormatCount = 2;
+      swapchain_format_list.pViewFormats = swapchain_view_formats;
+      swapchain_create_info.pNext = &swapchain_format_list;
+      swapchain_create_info.flags |= VK_SWAPCHAIN_CREATE_MUTABLE_FORMAT_BIT_KHR;
+      REXLOG_INFO("VulkanPresenter: Requesting an uncompressed swapchain");
+    }
+  }
   VkSwapchainKHR swapchain;
   if (dfn.vkCreateSwapchainKHR(device, &swapchain_create_info, nullptr, &swapchain) != VK_SUCCESS) {
     REXLOG_ERROR("VulkanPresenter: Failed to create a swapchain");
-- 
2.43.0

