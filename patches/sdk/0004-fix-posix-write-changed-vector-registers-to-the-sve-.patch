From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Wed, 14 Oct 2026 02:52:00 +0000
Subject: [PATCH] fix(posix): write changed vector registers to the sve context
 too

A handler that changes a vector register (to give a skipped load its
result, for instance) had no effect on CPUs with SVE while the thread
had live SVE state: the kernel then restores the vector registers from
the SVE record of the signal frame, not from fpsimd_context. qemu-user
always does.

The changed registers are now also written to the SVE record when it
holds the registers: Vn is the low 128 bits of Zn, and the rest is
cleared, as a write to Vn does.
---
 src/core/exception_handler_posix.cpp | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/core/exception_handler_posix.cpp b/src/core/exception_handler_posix.cpp
index 594a5d5..12f238c 100644
--- a/src/core/exception_handler_posix.cpp
+++ b/src/core/exception_handler_posix.cpp
@@ -137,6 +137,9 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
   thread_context.pstate = mcontext.pstate;
   struct fpsimd_context* mcontext_fpsimd = nullptr;
   struct esr_context* mcontext_esr = nullptr;
+#ifdef SVE_MAGIC
+  struct sve_context* mcontext_sve = nullptr;
+#endif
   for (struct _aarch64_ctx* mcontext_extension =
            reinterpret_cast<struct _aarch64_ctx*>(mcontext.__reserved);
        mcontext_extension->magic;
@@ -149,6 +152,11 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
       case ESR_MAGIC:
         mcontext_esr = reinterpret_cast<struct esr_context*>(mcontext_extension);
         break;
+#ifdef SVE_MAGIC
+      case SVE_MAGIC:
+        mcontext_sve = reinterpret_cast<struct sve_context*>(mcontext_extension);
+        break;
+#endif
       default:
         break;
     }
@@ -417,6 +425,20 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
           std::memcpy(&mcontext_fpsimd->vregs[modified_register_index],
                       &thread_context.v[modified_register_index], sizeof(vec128_t));
           mcontext.regs[modified_register_index] = thread_context.x[modified_register_index];
+#ifdef SVE_MAGIC
+          // While the thread has live SVE state, the vector registers are
+          // restored from the SVE record instead: Vn is the low 128 bits of
+          // Zn, and writing Vn clears the rest.
+          if (mcontext_sve) {
+            const uint32_t vq = sve_vq_from_vl(mcontext_sve->vl);
+            if (mcontext_sve->head.size >= SVE_SIG_CONTEXT_SIZE(vq)) {
+              uint8_t* zreg = reinterpret_cast<uint8_t*>(mcontext_sve) +
+                              SVE_SIG_ZREG_OFFSET(vq, modified_register_index);
+              std::memset(zreg, 0, SVE_SIG_ZREG_SIZE(vq));
+              std::memcpy(zreg, &thread_context.v[modified_register_index], sizeof(vec128_t));
+            }
+          }
+#endif
         }
       }
 #endif  // REX_PLATFORM_MAC
