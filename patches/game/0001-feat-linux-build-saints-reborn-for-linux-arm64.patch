+// World Studio (the developer-only world editor) is a Windows program that
+// talks to the game over a Windows named pipe. Elsewhere the game is built
+// without its bridge: everything stays as in a normal launch, where the
+// bridge is off.
+#include "world_studio_bridge.h"
+
+namespace sr::world_studio {
+
+bool EditorHostEnabled() { return false; }
+bool GetGizmoDraw(GizmoDraw&) { return false; }
+void AddMouseWheel(float) {}
+bool BeforeGameFrame(uint8_t*) { return true; }
+void OnPresent(PPCContext&, uint8_t*) {}
+bool OwnsCamera() { return false; }
+bool PlayMode() { return false; }
+void AfterFrameTimer(uint8_t*) {}
+void WriteEditorCamera(uint8_t*) {}
+
+}  // namespace sr::world_studio
