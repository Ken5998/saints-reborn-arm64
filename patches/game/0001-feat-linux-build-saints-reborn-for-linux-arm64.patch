diff --git a/project/src/sr_port.h b/project/src/sr_port.h
new file mode 100644
index 0000000..ac2a849
--- /dev/null
+++ b/project/src/sr_port.h
@@ -0,0 +1,64 @@
+#pragma once
+
+// What the game code needs from the compiler and the system outside Windows
+// x86-64: the SSE intrinsics (on ARM64 SIMDe maps them to NEON; CMake sets
+// SIMDE_ENABLE_NATIVE_ALIASES, since the SDK headers include SIMDe first),
+// __rdtsc, a few Win32 basics, the lookup of functions the SDK libraries
+// export by name, and the Windows key codes the code names (its key polling
+// itself is Windows only).
+
+#include <cstdint>
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <immintrin.h>
+#if defined(_WIN32)
+#include <intrin.h>
+#endif
+#else
+#include <simde/x86/sse4.1.h>
+// The time stamp counter of the x86 code: the generic timer here, which also
+// ticks at a fixed rate (callers measure its rate against a clock).
+inline uint64_t __rdtsc() {
+    uint64_t ticks;
+    __asm__ __volatile__("mrs %0, cntvct_el0" : "=r"(ticks));
+    return ticks;
+}
+#endif
+
+#if !defined(_WIN32)
+#include <dlfcn.h>
+#include <sched.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include <cwchar>
+
+#include <rex/win32_shims.h>
+
+using DWORD = uint32_t;
+inline DWORD GetCurrentThreadId() { return DWORD(gettid()); }
+inline uint32_t _byteswap_ulong(uint32_t v) { return __builtin_bswap32(v); }
+inline int _stricmp(const char* a, const char* b) { return strcasecmp(a, b); }
+inline int SwitchToThread() { return sched_yield() == 0; }
+
+// GetModuleHandleW + GetProcAddress on the SDK's libraries, already loaded
+// here as librexruntime.so and librexgpu-xenos.so. Other modules (the
+// Windows-only co-op and Zombies DLLs) are not there.
+using HMODULE = void*;
+inline HMODULE GetModuleHandleW(const wchar_t* name) {
+    const char* library = nullptr;
+    if (name && std::wcscmp(name, L"rexruntime.dll") == 0) library = "librexruntime.so";
+    if (name && std::wcscmp(name, L"rexgpu-xenos.dll") == 0) library = "librexgpu-xenos.so";
+    return library ? dlopen(library, RTLD_LAZY | RTLD_NOLOAD) : nullptr;
+}
+inline void* GetProcAddress(HMODULE module, const char* name) {
+    return module ? dlsym(module, name) : nullptr;
+}
