Date: Thu, 15 Oct 2026 08:39:24 +0000
Subject: [PATCH] feat(linux): fsr 1 upscaling and a 960x540 resolution

Display > Upscaling (restart) picks how the frame is stretched to the
window: bilinear, FSR 1 (EASU + RCAS) or CAS, saved in upscaling.txt and
handed to the presenter (present_effect) before it starts. Display >
Resolution gets 960 x 540, the game's 16:9 at three quarters of the size,
for handhelds to upscale to their screen; the low resolutions now carry
their own aspect ratio, and default to FSR 1.
---
 project/src/main.cpp         |  7 ++++
 project/src/options_menu.cpp | 71 ++++++++++++++++++++++++++++++------
 project/src/options_menu.h   |  9 ++++-
 3 files changed, 73 insertions(+), 14 deletions(-)

diff --git a/project/src/main.cpp b/project/src/main.cpp
index 447cc0a..2c20d19 100644
--- a/project/src/main.cpp
+++ b/project/src/main.cpp
@@ -715,6 +715,13 @@ public:
             std::fclose(vf);
             rex::cvar::SetFlagByName("present_vsync", "true");
         }
+        // Upscaling from the options menu (upscaling.txt): read by the
+        // presenter when it starts, in runtime_->Setup() below.
+        if (rex::cvar::SetFlagByName("present_effect", sr::UpscalingEffect())) {
+            REXLOG_INFO("Upscaling: {}", sr::UpscalingEffect());
+        } else {
+            REXLOG_WARN("Upscaling: {} is not available in this build", sr::UpscalingEffect());
+        }
         {
             // Internal resolution scale (1-3, default 2), read from
             // "res_scale.txt" next to the exe.
diff --git a/project/src/options_menu.cpp b/project/src/options_menu.cpp
index 57ac42d..6e90cf4 100644
--- a/project/src/options_menu.cpp
+++ b/project/src/options_menu.cpp
@@ -18,7 +18,8 @@
 //   res_scale.txt (1-3), start_windowed (file = windowed), vsync (file = on),
 //   fps_cap.txt, show_fps (file = shown), aspect.txt (4:3 ... 21:9, read at
 //   start-up; the old widescreen_off file counts as 4:3), mouse_sensitivity.txt,
-//   aim_assist_off (file = aim assist off).
+//   aim_assist_off (file = aim assist off), upscaling.txt (bilinear, fsr or
+//   cas, read at start-up).
 
 #include "options_menu.h"
 
@@ -102,12 +103,16 @@ int ReadAspectChoice() {
 const int g_aspect_running = ReadAspectChoice();
 
 // Low resolutions (Display > Resolution, frame_size.txt, read at start-up): a
-// smaller 4:3 frame. 640 x 480 is the game's own SD (4:3 TV) mode.
+// smaller frame. 640 x 480 is the game's own SD (4:3 TV) mode; 960 x 540 is
+// the game's 16:9 at three quarters of the size, for handhelds that upscale it
+// to the screen (Upscaling: FSR 1).
 struct FrameChoice {
   const char* name;
   int w, h;
+  int x, y;  // aspect ratio
 };
-constexpr FrameChoice kFrames[] = {{"640x480", 640, 480}, {"800x600", 800, 600}};
+constexpr FrameChoice kFrames[] = {
+    {"640x480", 640, 480, 4, 3}, {"800x600", 800, 600, 4, 3}, {"960x540", 960, 540, 16, 9}};
 constexpr int kFrameCount = int(sizeof(kFrames) / sizeof(kFrames[0]));
 int ReadFrameChoice() {
   if (FILE* f = std::fopen("frame_size.txt", "rb")) {
@@ -124,6 +129,30 @@ int ReadFrameChoice() {
 const int g_frame_running = ReadFrameChoice();
 float AspectRatioOf(int i) { return float(kAspects[i].x) / float(kAspects[i].y); }
 
+// Upscaling (Display > Upscaling, upscaling.txt, read at start-up): how the
+// frame is stretched to the window, the presenter's present_effect. FSR 1 is
+// AMD FidelityFX Super Resolution 1 (EASU, an edge-preserving upscale, then
+// RCAS sharpening); CAS is Contrast Adaptive Sharpening. Without the file:
+// FSR 1 for the low resolutions, bilinear otherwise.
+struct UpscalingChoice {
+  const char* name;
+  const char* effect;
+};
+constexpr UpscalingChoice kUpscalings[] = {{"Bilinear", "bilinear"}, {"FSR 1", "fsr"}, {"CAS", "cas"}};
+constexpr int kUpscalingCount = int(sizeof(kUpscalings) / sizeof(kUpscalings[0]));
+int ReadUpscalingChoice(int frame) {
+  if (FILE* f = std::fopen("upscaling.txt", "rb")) {
+    char buf[16] = {};
+    const size_t n = std::fread(buf, 1, sizeof(buf) - 1, f);
+    std::fclose(f);
+    std::string text(buf, n);
+    while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) text.pop_back();
+    for (int i = 0; i < kUpscalingCount; ++i)
+      if (text == kUpscalings[i].effect) return i;
+  }
+  return frame >= 0 ? 1 : 0;
+}
+
 int ReadScaleFile() {
   int scale = 2;
   if (FILE* f = std::fopen("res_scale.txt", "rb")) {
@@ -190,8 +219,8 @@ std::vector<Row>& Rows() {
       // running; with Vulkan the scale (res_scale.txt) applies at start-up.
       {"Resolution (restart)",
 #endif
-       {"640 x 480 (restart)", "800 x 600 (restart)", "1280 x 720 (native)", "2560 x 1440 (2x)",
-        "3840 x 2160 (3x)"},
+       {"640 x 480 (restart)", "800 x 600 (restart)", "960 x 540 (restart)", "1280 x 720 (native)",
+        "2560 x 1440 (2x)", "3840 x 2160 (3x)"},
        [] {
          const int frame = ReadFrameChoice();
          return frame >= 0 ? frame : kFrameCount + g_running_scale - 1;
@@ -257,6 +286,15 @@ std::vector<Row>& Rows() {
          std::remove("widescreen_off");
        },
        false},
+      {"Upscaling (restart)", {"Bilinear", "FSR 1", "CAS"},
+       [] { return ReadUpscalingChoice(ReadFrameChoice()); },
+       [](int c) {
+         if (FILE* f = std::fopen("upscaling.txt", "wb")) {
+           std::fprintf(f, "%s\n", kUpscalings[c].effect);
+           std::fclose(f);
+         }
+       },
+       false},
       // The game's own shadow setting (console variable r_shadows at
       // 0x827D6C90): 2 = shadow maps + CPU-built stencil shadows (the
       // default), 3 = shadow maps only, 1 = stencil only, 0 = none. Measured at
@@ -412,9 +450,14 @@ int sr::AspectFrameWidth() {
   if (g_aspect_running == kAspectDefault) return 0;
   return int(std::lround(720.0 * AspectRatioOf(g_aspect_running) / 16.0)) * 16;
 }
-float sr::AspectRatioValue() { return g_frame_running >= 0 ? 4.0f / 3.0f : AspectRatioOf(g_aspect_running); }
+float sr::AspectRatioValue() {
+  if (g_frame_running >= 0) return float(kFrames[g_frame_running].x) / float(kFrames[g_frame_running].y);
+  return AspectRatioOf(g_aspect_running);
+}
 int sr::FrameHeight() { return g_frame_running >= 0 ? kFrames[g_frame_running].h : 720; }
 
+const char* sr::UpscalingEffect() { return kUpscalings[ReadUpscalingChoice(g_frame_running)].effect; }
+
 void sr::SetDefaultResScale(int scale) {
   if (scale >= 1 && scale <= 3) g_running_scale = scale;
 }
@@ -478,12 +521,16 @@ void sr::OptionsMenuPoll(uint8_t* base) {
   static bool presenter_set = false;
   if (!presenter_set) {
     presenter_set = true;
-    const bool own = g_aspect_running == kAspectDefault && g_frame_running < 0;
-    const bool four_three = g_frame_running >= 0;
-    rex::cvar::SetFlagByName("present_aspect_x",
-                             std::to_string(own ? 0 : four_three ? 4 : kAspects[g_aspect_running].x));
-    rex::cvar::SetFlagByName("present_aspect_y",
-                             std::to_string(own ? 0 : four_three ? 3 : kAspects[g_aspect_running].y));
+    int x = 0, y = 0;  // the guest's own shape
+    if (g_frame_running >= 0) {
+      x = kFrames[g_frame_running].x;
+      y = kFrames[g_frame_running].y;
+    } else if (g_aspect_running != kAspectDefault) {
+      x = kAspects[g_aspect_running].x;
+      y = kAspects[g_aspect_running].y;
+    }
+    rex::cvar::SetFlagByName("present_aspect_x", std::to_string(x));
+    rex::cvar::SetFlagByName("present_aspect_y", std::to_string(y));
   }
   // Widescreen: the game sets the flag once at start-up from the video mode
   // (1 for 16:9). Aspect ratios below 16:10 force 0.
diff --git a/project/src/options_menu.h b/project/src/options_menu.h
index c93d81d..f9f56d0 100644
--- a/project/src/options_menu.h
+++ b/project/src/options_menu.h
@@ -32,8 +32,13 @@ void OptionsMenuPoll(uint8_t* base);
 // 1280, i.e. 16:9) and the ratio itself.
 int AspectFrameWidth();
 float AspectRatioValue();
-// Frame height for the same: 720, or 480 / 600 for the low resolutions
-// (frame_size.txt; Display > Resolution, after a restart; always 4:3).
+// Frame height for the same: 720, or 480 / 600 / 540 for the low resolutions
+// (frame_size.txt; Display > Resolution, after a restart; 4:3, or 16:9 for
+// 960 x 540).
 int FrameHeight();
 
+// The presenter's present_effect for this run (upscaling.txt; Display >
+// Upscaling, after a restart): bilinear, fsr or cas.
+const char* UpscalingEffect();
+
 }  // namespace sr
